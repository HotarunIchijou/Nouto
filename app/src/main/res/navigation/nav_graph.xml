<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="org.kaorun.nouto.ui.fragments.MainFragment"
        android:label="fragment_main"
        tools:layout="@layout/fragment_main" >
        <action
            android:id="@+id/action_mainFragment_to_noteFragment"
            app:destination="@id/noteFragment" />
        <action
            android:id="@+id/action_mainFragment_to_settingsMainFragment"
            app:destination="@id/settingsMainFragment" />
        <action
            android:id="@+id/action_mainFragment_to_trashFragment"
            app:destination="@id/trashFragment" />
    </fragment>

    <fragment
        android:id="@+id/noteFragment"
        android:name="org.kaorun.nouto.ui.fragments.NoteFragment"
        android:label="fragment_note"
        tools:layout="@layout/fragment_note">
        <argument
            android:name="note_id"
            app:argType="integer"
            android:defaultValue="-1" />
        <argument
            android:name="title"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="content"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
    <fragment
        android:id="@+id/settingsMainFragment"
        android:name="org.kaorun.nouto.ui.fragments.settings.SettingsMainFragment"
        android:label="SettingsFragment"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsMainFragment_to_settingsAppearanceFragment"
            app:destination="@id/settingsAppearanceFragment" />
        <action
            android:id="@+id/action_settingsMainFragment_to_settingsAboutFragment"
            app:destination="@id/settingsAboutFragment" />
        <action
            android:id="@+id/action_settingsMainFragment_to_settingsBackupRestoreFragment"
            app:destination="@id/settingsBackupRestoreFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsAppearanceFragment"
        android:name="org.kaorun.nouto.ui.fragments.settings.SettingsAppearanceFragment"
        android:label="SettingsAppearanceFragment"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/trashFragment"
        android:name="org.kaorun.nouto.ui.fragments.TrashFragment"
        android:label="trashFragment"
        tools:layout="@layout/fragment_trash">
        <action
            android:id="@+id/action_trashFragment_to_noteFragment"
            app:destination="@id/noteFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsAboutFragment"
        android:name="org.kaorun.nouto.ui.fragments.settings.SettingsAboutFragment"
        android:label="SettingsAboutFragment"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/settingsBackupRestoreFragment"
        android:name="org.kaorun.nouto.ui.fragments.settings.SettingsBackupRestoreFragment"
        android:label="SettingsBackupRestoreFragment"
        tools:layout="@layout/fragment_settings" >
        <action
            android:id="@+id/action_settingsBackupRestoreFragment_to_noteFragment"
            app:destination="@id/noteFragment" />
        <action
            android:id="@+id/action_settingsBackupRestoreFragment_to_noteExportFragment"
            app:destination="@id/noteExportFragment" />
    </fragment>
    <fragment
        android:id="@+id/noteExportFragment"
        android:name="org.kaorun.nouto.ui.fragments.settings.SettingsNoteExportFragment"
        android:label="NoteExportFragment"
        tools:layout="@layout/fragment_note_export" />

</navigation>