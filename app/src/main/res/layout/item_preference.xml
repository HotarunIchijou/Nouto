<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.listitem.ListItemLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="?listItemLayoutStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <com.google.android.material.listitem.ListItemCardView
        style="?listItemCardViewSegmentedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginVertical="6dp">

            <FrameLayout
                android:id="@android:id/icon_frame"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@android:id/icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/info_24px" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:orientation="vertical">

                <TextView
                    android:id="@android:id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:textAppearance="?textAppearanceListItem"
                    android:textColor="?colorOnSurface"
                    android:textFontWeight="500"
                    android:includeFontPadding="false"
                    android:lineHeight="21sp"
                    android:firstBaselineToTopHeight="16.5sp"
                    android:lastBaselineToBottomHeight="4.5sp"
                    tools:text="@string/about" />

                <TextView
                    android:id="@android:id/summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="10"
                    android:textAppearance="?textAppearanceListItemSecondary"
                    android:textColor="?colorOnSurfaceVariant"
                    android:includeFontPadding="false"
                    android:lineHeight="19sp"
                    android:firstBaselineToTopHeight="15sp"
                    android:lastBaselineToBottomHeight="4sp"
                    tools:text="@string/about_summary" />
            </LinearLayout>

            <FrameLayout
                android:id="@android:id/widget_frame"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </com.google.android.material.listitem.ListItemCardView>
</com.google.android.material.listitem.ListItemLayout>