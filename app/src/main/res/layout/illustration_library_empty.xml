<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/library_empty_layout"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:layout_gravity="center"
	tools:ignore="UseCompoundDrawables">

	<ImageView
		android:layout_width="260dp"
		android:layout_height="260dp"
		android:src="@drawable/illustration_notes_empty"
		android:layout_gravity="center"
		tools:ignore="ContentDescription" />

	<TextView
		android:id="@+id/empty_text_view"
		android:layout_width="wrap_content"
		android:layout_height="match_parent"
		android:layout_gravity="center"
		android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceTitleLargeEmphasized"
        android:textFontWeight="500"
        android:fontFamily="@font/google_sans_flex_round"
		android:text="@string/library_empty" />
</LinearLayout>
